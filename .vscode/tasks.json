{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Abrir visor local",
            "type": "shell",
            "command": "python servidor-local.py",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "isBackground": true,
            "runOptions": {
                "runOn": "folderOpen"
            },
            "presentation": {
                "reveal": "silent",
                "panel": "dedicated",
                "close": false
            },
            "problemMatcher": {
                "owner": "http",
                "pattern": {
                    "regexp": "^$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".",
                    "endsPattern": "Serving HTTP"
                }
            }
        }
    ]
}
